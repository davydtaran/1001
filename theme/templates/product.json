style=\"width:100px;\">\n    {% endif %}\n    {% if product.metafields.custom.feature_text_3 %}\n      <p>{{ product.metafields.custom.feature_text_3 }}<\/p>\n    {% endif %}\n  <\/div>\n{% endif %}\n\n<!-- 📄 Description heading -->\n{% if product.metafields.custom.description_heading %}\n  <h3 style=\"font-size:22px;margin-top:40px;\">\n    {{ product.metafields.custom.description_heading }}\n  <\/h3>\n{% endif %}\n\n<!-- 📄 Description content -->\n{% if product.metafields.custom.description_content %}\n  <div style=\"margin-top:10px;line-height:1.6;\">\n    {{ product.metafields.custom.description_content }}\n  <\/div>\n{% endif %}","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["spacer-custom-top","main","related-products","1749764619fc074f2e","custom_liquid_wp7M44"]}