<style>
@media (min-width: 750px) { .only-mobile { display: none !important; } }
@media (max-width: 749px) { .only-desktop { display: none !important; } }
</style>

<div class="slideshow-section {% if section.settings.visibility == 'mobile' %}only-mobile{% elsif section.settings.visibility == 'desktop' %}only-desktop{% endif %}">
  <div class="slideshow">
    {% for block in section.blocks %}
      {% if block.type == 'slide' %}
      <div class="slideshow__slide" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="{{ block.settings.alt | escape }}" loading="lazy">
        {% endif %}
        {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
          <div class="slideshow__content">
            {% if block.settings.heading != blank %}
              <h2>{{ block.settings.heading }}</h2>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="rte">{{ block.settings.text }}</div>
            {% endif %}
            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}">{{ block.settings.button_label | escape }}</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "label": "Display on",
      "default": "all",
      "options": [
        { "value": "all", "label": "All devices" },
        { "value": "desktop", "label": "Desktop only" },
        { "value": "mobile", "label": "Mobile only" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "button_style_secondary", "label": "Outline button", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [ { "type": "slide" }, { "type": "slide" } ]
    }
  ]
}
{% endschema %}

