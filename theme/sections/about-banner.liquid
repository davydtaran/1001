<style>
@media (min-width: 750px) { .only-mobile { display: none !important; } }
@media (max-width: 749px) { .only-desktop { display: none !important; } }
</style>
<section class="{% if section.settings.visibility == "mobile" %}only-mobile{% elsif section.settings.visibility == "desktop" %}only-desktop{% endif %}" style="position: relative; width: 100%; min-height: 620px;">
  <div style="
    background-image: url({{ section.settings.image | img_url: 'master' }});
    background-size: cover;
    background-position: center;
    width: 100%;
    min-height: 620px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 60px 40px;
    color: #111;
    font-family: 'Helvetica Neue', 'Segoe UI', sans-serif;
    background-color: #f4f4f4;
  ">
    <div style="flex: 1 1 48%; max-width: 48%;">
      <h2 style="font-size: 34px; font-weight: 600; margin-bottom: 18px; line-height: 1.3; color: #111;">
        Designer Lighting<br>for Home & Business
      </h2>

<a href="/collections" class="glow-button">Collections →</a>

    </div>

    <div style="flex: 1 1 48%; max-width: 48%; font-family: 'Georgia', 'Baskerville', serif;">
      <p style="font-size: 18px; margin-bottom: 35px; line-height: 1.7; font-weight: 400;">
        We help clients create cozy and stylish interiors with lighting. 
        Our wide assortment ensures everyone finds the perfect light to reflect their taste and style. 
        Together we’ll shape a space that you’ll always want to return to.
      </p>
      <ul style="list-style: none; padding: 0; font-weight: 500; font-size: 17px; display: flex; flex-wrap: wrap; gap: 24px;">
        <li style="width: 45%; display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
  <img src="{{ 'lamp-icon.png' | asset_url }}" alt="icon" style="width: 35px; height: 35px;">
  Wide Selection
</li>
<li style="width: 45%; display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
  <img src="{{ 'lamp-icon.png' | asset_url }}" alt="icon" style="width: 35px; height: 35px;">
  Safety & Quality
</li>
<li style="width: 45%; display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
  <img src="{{ 'lamp-icon.png' | asset_url }}" alt="icon" style="width: 35px; height: 35px;">
  Designer Releases
</li>
<li style="width: 45%; display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
  <img src="{{ 'lamp-icon.png' | asset_url }}" alt="icon" style="width: 35px; height: 35px;">
  Customer-Focused
</li>


      </ul>
    </div>
  </div>
</section>

<
{% schema %}
{
  "name": "About Banner Refined",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "About Us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
      {
        "type": "select",
        "id": "visibility",
        "label": "Display on",
        "default": "all",
        "options": [
          { "value": "all", "label": "All devices" },
          { "value": "desktop", "label": "Desktop only" },
          { "value": "mobile", "label": "Mobile only" }
        ]
      }
  ],
  "presets": [
    {
      "name": "About Banner Refined",
      "category": "Custom"
    }
  ]
}
{% endschema %}
