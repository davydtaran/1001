a9f2-4160-9fe9-4fec8413e5d8","settings":{}}},"block_order":["judge_me_reviews_review_widget_VgaMck"],"disabled":true,"settings":{"include_margins":true}},"custom_liquid_wp7M44":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<!-- 🖼 Banner -->\n{% assign banner = product.metafields.custom.banner_image %}\n{% if banner %}\n  {% assign ext = banner | split: '.' | last %}\n  {% if ext == 'mp4' %}\n    <video controls autoplay muted loop style=\"width:100%;margin-bottom:30px;\">\n      <source src=\"{{ banner | file_url }}\" type=\"video\/mp4\">\n    <\/video>\n  {% else %}\n    <img src=\"{{ banner | image_url: 'master' }}\" alt=\"Banner\" style=\"width:100%;margin-bottom:30px;\">\n  {% endif %}\n{% endif %}\n\n<!-- 🏷 Banner heading -->\n{% if product.metafields.custom.banner_heading %}\n  <h2 style=\"text-align:center;font-size:28px;margin-bottom:20px;\">\n    {{ product.metafields.custom.banner_heading }}\n  <\/h2>\n{% endif %}\n\n<!-- 💡 Feature 1 -->\n{% if product.metafields.custom.feature_image_1 or product.metafields.custom.feature_text_1 %}\n  <div style=\"display:flex;gap:20px;align-items:center;margin-bottom:30px;\">\n    {% if product.metafields.custom.feature_image_1 %}\n      <img src=\"{{ product.metafields.custom.feature_image_1 | image_url: 'medium' }}\" style=\"width:100px;\">\n    {% endif %}\n    {% if product.metafields.custom.feature_text_1 %}\n      <p>{{ product.metafields.custom.feature_text_1 }}<\/p>\n    {% endif %}\n  <\/div>\n{% endif %}\n\n<!-- 💡 Feature 2 -->\n{% if product.metafields.custom.feature_image_2 or product.metafields.custom.feature_text_2 %}\n  <div style=\"display:flex;gap:20px;align-items:center;margin-bottom:30px;\">\n    {% if product.metafields.custom.feature_image_2 %}\n      <img src=\"{{ product.metafields.custom.feature_image_2 | image_url: 'medium' }}\" style=\"width:100px;\">\n    {% endif %}\n    {% if product.metafields.custom.feature_text_2 %}\n      <p>{{ product.metafields.custom.feature_text_2 }}<\/p>\n    {% endif %}\n  <\/div>\n{% endif %}\n\n<!-- 💡 Feature 3 -->\n{% if product.metafields.custom.feature_image_3 or product.metafields.custom.feature_text_3 %}\n  <div style=\"display:flex;gap:20px;align-items:center;margin-bottom:30px;\">\n    {% if product.metafields.custom.feature_image_3 %}\n      <img src=\"{{ product.metafields.custom.feature_image_3 | image_url: 'medium' }}\" style=\"width:100px;\">\n    {% endif %}\n    {% if product.metafields.custom.feature_text_3 %}\n      <p>{{ product.metafields.custom.feature_text_3 }}<\/p>\n    {% endif %}\n  <\/div>\n{% endif %}\n\n<!-- 📄 Description heading -->\n{% if product.metafields.custom.description_heading %}\n  <h3 style=\"font-size:22px;margin-top:40px;\">\n    {{ product.metafields.custom.description_heading }}\n  <\/h3>\n{% endif %}\n\n<!-- 📄 Description content -->\n{% if product.metafields.custom.description_content %}\n  <div style=\"margin-top:10px;line-height:1.6;\">\n    {{ product.metafields.custom.description_content }}\n  <\/div>\n{% endif %}\n\n{% if product.metafields.custom.tall_images != blank %}\n  {% for image in product.metafields.custom.tall_images %}\n    <img src=\"{{ image | file_url }}\" alt=\"Image\" style=\"width: 100%; max-width: 1000px; margin: 10px auto;\" \/>\n  {% endfor %}\n{% endif %}\n{% assign slides = product.metafields.custom.slide_banner_with_titles.value %}\n\n{% assign slides = product.metafields.custom.slide_banner_with_titles.value %}\n\n{% if slides != blank %}\n  <div class=\"slide-banner-wrapper\">\n    {% for slide in slides %}\n      <div class=\"slide-item\" style=\"margin-bottom: 30px; text-align: center;\">\n        {% if slide.image != blank %}\n          <img src=\"{{ slide.image.value | image_url: width: 1200 }}\" alt=\"Slide Image\" style=\"max-width: 100%; height: auto; margin-bottom: 10px;\">\n        {% endif %}\n        {% if slide.title != blank %}\n          <p style=\"font-size: 20px; font-weight: 600;\">{{ slide.title }}<\/p>\n        {% endif %}\n      <\/div>\n    {% endfor %}\n  <\/div>\n{% endif %}","color_scheme":"","padding_top":40,"padding_bottom":52}},"smart-dynamic-block":{"type":"smart-dynamic-content","settings":{}}},"order":["spacer-custom-top","main","related-products","1749764619fc074f2e","custom_liquid_wp7M44","smart-dynamic-block"]}