{"sections":{"main":{"type":"main-page","settings":{"padding_top":36,"padding_bottom":36}},"custom_liquid_iRWtBe":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div id=\"wishlist-items\" style=\"color: white; padding: 20px; font-size: 18px;\">Loading wishlist...<\/div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const container = document.getElementById(\"wishlist-items\");\n    const wishlist = JSON.parse(localStorage.getItem(\"wishlist\") || \"[]\");\n\n    if (wishlist.length === 0) {\n      container.textContent = \"Your wishlist is empty ❤️\";\n      return;\n    }\n\n    fetch('\/collections\/all?view=wishlist-json')\n      .then(res => res.text())\n      .then(data => {\n        const parser = new DOMParser();\n        const doc = parser.parseFromString(data, \"text\/html\");\n        const allItems = doc.querySelectorAll('[data-product-handle]');\n        container.innerHTML = '';\n        wishlist.forEach(handle => {\n          const match = [...allItems].find(el => el.dataset.productHandle === handle);\n          if (match) container.appendChild(match.cloneNode(true));\n        });\n      });\n  });\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_iRWtBe"]}