<section style="padding: 40px; background-color: black; color: white;">
  <h2 style="font-size: 28px; margin-bottom: 20px;">Tall Ceiling Lighting</h2>

  {% if product.metafields.custom.tall_image %}
    <img src="{{ product.metafields.custom.tall_image | image_url: 'master' }}" style="width:100%;margin-bottom:20px;">
  {% endif %}

  {% if product.metafields.custom.specifications %}
    <h3>Specifications</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      {% assign lines = product.metafields.custom.specifications | newline_to_br | split: '<br />' %}
      {% for line in lines %}
        <li>{{ line | strip }}</li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
